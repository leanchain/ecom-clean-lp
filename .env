# SendPulse lead capture runs in the Cloudflare Worker (main.js), not in Next.
# Set these as Worker secrets, not here:
#   bunx wrangler secret put SENDPULSE_CLIENT_ID
#   bunx wrangler secret put SENDPULSE_CLIENT_SECRET
#   bunx wrangler secret put SENDPULSE_ADDRESS_BOOK_ID
# For local `wrangler dev`, put the same three keys in an untracked .dev.vars file.
