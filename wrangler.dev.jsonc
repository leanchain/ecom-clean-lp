// Local development only. `npm run dev` runs the worker in front of `next dev`
// so /api/* behaves exactly as it does in production, while everything else is
// handed to Next (DEV_ORIGIN) for hot reload.
//
// There is deliberately no `assets` block here: in production the exported
// ./out directory is served before the worker runs, which in development would
// pin the page to the last `npm run build` instead of your live edits.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beseam-dev",
  "main": "main.js",
  "compatibility_date": "2026-07-18",
  "send_email": [
    {
      "name": "REVIEW_EMAIL",
      "destination_address": "hello@beseam.com",
      "allowed_sender_addresses": ["hello@beseam.com"],
    },
  ],
}
